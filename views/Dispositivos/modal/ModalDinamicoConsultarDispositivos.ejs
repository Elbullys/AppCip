<div class="modal-body p-0">
    
    <div id="vistaFormulario" class="p-3">
        <div class="form-group mb-3">
            <label class="form-label font-weight-bold text-secondary">Dispositivo Asociado</label>
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-white"><i class="fas fa-laptop text-primary"></i></span>
                <input type="text" id="inputNombreDisp" class="form-control bg-light" placeholder="Seleccione un equipo..." readonly style="cursor: default;">
                <button class="btn btn-primary px-3" type="button" id="btnAbrirBuscador">
                    <i class="fas fa-search"></i> <span class="d-none d-md-inline">Buscar</span>
                </button>
            </div>
            <input type="hidden" id="inputIdDisp">
        </div>
        
        </div>

    <div id="vistaBuscador" style="display: none;" class="bg-white">
        <div class="p-3 border-bottom sticky-top bg-white">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="m-0 font-weight-bold"><i class="fas fa-list-ul me-2"></i>Catálogo de Equipos</h6>
                <button type="button" class="btn-close" id="btnCerrarBuscador"></button>
            </div>
            <div class="input-group">
                <input type="text" id="inputBusquedaDispositivo" class="form-control form-control-lg" placeholder="Marca, serie o modelo...">
                <button class="btn btn-dark" type="button" id="btnEjecutarBusqueda">
                    <i class="fas fa-filter"></i>
                </button>
            </div>
        </div>

        <div id="listaResultados" class="list-group list-group-flush" style="min-height: 200px; max-height: 350px; overflow-y: auto;">
            <div class="text-center p-5 text-muted">
                <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                <p>Escribe algo para consultar la base de datos</p>
            </div>
        </div>

        <div class="p-2 border-top">
            <button type="button" class="btn btn-link text-decoration-none w-100" id="btnRegresarForm">
                <i class="fas fa-arrow-left"></i> Volver al formulario
            </button>
        </div>
    </div>
</div>