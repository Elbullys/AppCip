<!-- Modal para mostrar los detalles del DISPOSITIVO -->
<div class="modal fade" id="consultaDispositivosModal" data-bs-backdrop="static" data-bs-keyboard="true" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title titulo_modal">Selecciona un Dispositivo</h5>
                <button type="button" class="btn-close-custom btn-secondary" data-bs-dismiss="modal" tabindex="-1"><i class="fas fa-times"></i></button> 
            </div>
            
            <div class="modal-body"> 
                <div class="card-body"> 
                    <div class="input-group mb-3">
                        <input type="text" id="inputBusquedadispositivo" class="form-control" placeholder="Buscar dispositivo..." autocomplete="off"  tabindex="1">
                        <button id="btnBuscarDispositivo" class="btn btn-primary">Buscar</button>
                    </div>
                </div>
            </div> 
                <div class="table-responsive mb-3">  
                    <table id="table_Modal_ConsultaDispositivos" class="table tableModalConsulta table-striped table-hover table-sm" style="width:100%">
                        <thead>
                            <tr>
                                <th scope="col">Id Dispositivo</th>
                                <th scope="col">Dispositivo</th>
                                <th scope="col">Abreviatura</th>
                            </tr>
                        </thead>
                        <tbody>
                           
                        </tbody>
                    </table>
                </div>
                
                <div class="text-center mt-2 mb-2"> 
                    <button type="button" id="btnSeleccionardispositivo" class="btn btn-primary">Seleccionar</button>
                   
                </div>
        </div>
    </div>
</div>

