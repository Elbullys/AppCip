<div class="modal fade" id="upsertCatalogoModal" tabindex="-1" aria-labelledby="upsertCatalogoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="upsertCatalogoModalLabel">Agregar Catálogo de Componentes</h5>
                 <button type="button" id="btoncloseupsertCatalogomodal" class="btn-close-custom btn-secondary" data-bs-dismiss="modal" tabindex="-1"><i class="fas fa-times"></i></button> 

            </div>
            <div class="modal-body">
                <form id="formularioupsertCatalogo" action="" method="POST" enctype="multipart/form-data" autocomplete="off">
                    <!-- Inputs principales: Nombre, Dispositivo, Marca/Modelo -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="inputnombrecatalogo" class="form-label">Nombre del Catálogo</label>
                            <input type="text" id="inputnombrecatalogo" class="form-control" placeholder="Nombre del Cátalogo" required disabled/>
                        </div>
                        <div class="col-md-6">
                            <label for="inputdispositivo" class="form-label">Dispositivo</label>
                            <input type="text" id="inputdispositivo" class="form-control" placeholder="Dispositivo" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="inputmarcamodelo" class="form-label">Marca/Modelo</label>
                        <input type="text" id="inputmarcamodelo" class="form-control" placeholder="Marca/Modelo" required />
                    </div>
                    <div class="mb-3">
                        <label for="inputdescripcioncatalogo" class="form-label">Descripción del Catálogo</label>
                        <textarea class="form-control" id="inputdescripcioncatalogo" placeholder="Descripción del catálogo" rows="3" autocomplete="off"></textarea>
                    </div>

                    <!-- Sesión Adicional: Selects en grid -->
                    <div id="sesionAdicional" class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="selectprocesador" class="form-label">Procesador</label>
                            <select class="form-select" name="procesador" id="selectprocesador" required>
                                <option value="" selected disabled>Seleccione un procesador</option>
                                <!-- Agrega opciones dinámicamente aquí -->
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="selectmemoriaram" class="form-label">Memoria RAM</label>
                            <select class="form-select" name="memoriaram" id="selectmemoriaram" required>
                                <option value="" selected disabled>Seleccione memoria RAM</option>
                                <!-- Agrega opciones dinámicamente aquí -->
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="selectdiscoduro" class="form-label">Disco Duro</label>
                            <select class="form-select" name="discoduro" id="selectdiscoduro" required>
                                <option value="" selected disabled>Seleccione disco duro</option>
                                <!-- Agrega opciones dinámicamente aquí -->
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="selectsistemaoperativo" class="form-label">Sistema Operativo</label>
                            <select class="form-select" name="sistemaoperativo" id="selectsistemaoperativo" required>
                                <option value="" selected disabled>Seleccione sistema operativo</option>
                                <!-- Agrega opciones dinámicamente aquí -->
                            </select>
                        </div>
                    </div>

                    <!-- Botón de registrar -->
                    <div class="d-grid gap-2">
                        <button type="button" id="btonupsertcatalogo" class="btn btn-primary">Registrar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>