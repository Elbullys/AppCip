<%- include("../template/cabecera",{tituloweb:'Agregar Componente'}) %>
<%- include("../template/navbar") %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="form-container">
        <!-- Header del formulario -->

        <div class="form-header text-center">
          <h1 ><i class="fa-solid fa-computer"></i>  Agregar Componente</h1>
          <p class="mb-0">Complete todos los campos requeridos (*)</p>
        </div>


        <!-- DATOS PRINCIPALES DE COMPONENTE -->
        <div class="row g-3 m-2">
          <div class="col-md-6">
            <label for="componenteID" class="form-label" tabindex="-1">ID Componente</label>
            <div class="input-icon">
              <i class="fa-solid fa-hashtag"></i>
              <input
                type="text"
                class="form-control"
                id="txtidcomponente"
                placeholder="ID Componente"
                disabled="false"
                value="*"
                tabindex="-1"
              
              />
            </div>
          </div>
        </div>

        <form
          class="p-4 p-md-5"
          id="FormAgregarComponente" 
          autocomplete="off"
        >
          <input type="hidden" name="id" id="idcomponenteHidden" tabindex="-1"/>
          <!-- Sección de ubicacion del equipo-->
          <div class="mb-5">
            <h3 class="section-title">
              <i class="fa-solid fa-location-dot" tabindex="-1"></i> Ubicación del Equipo
            </h3>
            <div class="row g-3" tabindex="-1">
              <div class="col-md-6" tabindex="-1">
                <label for="unidad" class="form-label" tabindex="-1">Id Unidad</label>
                <div class="input-icon" tabindex="-1">
                  <i class="fa-solid fa-hashtag"></i>
                  <input
                    type="text"
                    class="form-control"
                    id="txtIdUnidad"
                    placeholder="Id Unidad"
                    autocomplete="off"
                    tabindex="0"
                    readonly
                    style="cursor: pointer; background-color: #fff;"
                  required
                  />
                </div>
              </div>
              <div class="col-md-6" >
                <label for="unidad" class="form-label" >Nombre de Unidad</label>
                <div class="input-icon" >
                  <i class="fa-solid fa-building"></i>
                  <input
                    type="text"
                    class="form-control"
                    id="txtnombreunidad"
                    placeholder="Unidad"
                    disabled="false"
                    tabindex="-1"
                  />
                </div>
              </div>
              <div class="col-md-6" tabindex="-1">
                <label for="unidad" class="form-label" tabindex="-1">Operación</label>
                <div class="input-icon" tabindex="-1">
                  <i class="fa-solid fa-briefcase" tabindex="-1"></i>
                  <input
                    type="text"
                    class="form-control"
                    id="txtoperacion"
                    placeholder="Operación"
                    disabled="false"
                    tabindex="-1"
                  />
                </div>
              </div>
              <div class="col-md-6" tabindex="-1">
                <label for="ubicacion" class="form-label" tabindex="-1"
                  >Ubicacion de Equipo</label
                >
                <div class="input-icon" tabindex="-1">
                  <i class="fa-solid fa-thumbtack"></i>
                  <input
                    type="text"
                    class="form-control"
                    id="txtarea"
                    placeholder="Ubicación"
                    autocomplete="off"
                    readonly
                    style="cursor: pointer; background-color: #fff;"
                    tabindex="2"
                    required
                  />
                </div>
              </div>
            </div>
          </div>
<!-- Sección de Responsable-->
          <div class="mb-5">
            <h3 class="section-title">
              <i class="fa fa-users"></i> Responsable del Equipo
            </h3>
            <div class="row g-3">
              <div class="col-md-6">
                <label for="unidad" class="form-label">ID del Responsable</label>
                <div class="input-icon">
                  <i class="fa-solid fa-hashtag"></i>
                  <input
                    type="text"
                    class="form-control"
                    id="txtidresponsable"
                    placeholder="ID del Responsable"
                    autocomplete="off"
                    tabindex="3"
                    readonly
                    style="cursor: pointer; background-color: #fff;"
                    required
                  />
                </div>
              </div>
              <div class="col-md-6">
                <label for="unidad" class="form-label">Nombre del Responsable</label>
                <div class="input-icon">
                  <i class="fa fa-user-circle"></i>
                  <input
                    type="text"
                    class="form-control"
                    id="txtnombreresponsable"
                    placeholder="Nombre del Responsable"
                    autocomplete="off"
                    disabled="false"
                    tabindex="-1"
                  />
                </div>
              </div>
              <div class="col-md-6">
                <label for="unidad" class="form-label">Cargo</label>
                <div class="input-icon">
                  <i class="fa fa-handshake"></i>
                  <input
                    type="text"
                    class="form-control"
                    id="txtcargoresponsable"
                    placeholder="Cargo"
                    disabled="false"
                    tabindex="-1"
                  />
                </div>
              </div>
              <div class="col-md-6">
                <label for="unidad" class="form-label">Área</label>
                <div class="input-icon">
                  <i class="fa-solid fa-briefcase"></i>
                  <input
                    type="text"
                    class="form-control"
                    id="txtarearesponsable"
                    placeholder="Área del Responsable"
                    disabled="false"
                    tabindex="-1"
                  />
                </div>
              </div>
            </div>
          </div>
          <!-- Sección de caracteristicas del equipo -->
          <div class="mb-5">
            <h3 class="section-title">
              <i class="fas fa-info-circle"></i> Características del Equipo
            </h3>
            <div class="row g-3">
              <div class="col-md-6">
                <label for="unidad" class="form-label">Id Dispositivo</label>
                <div class="input-icon">
                  <i class="fa-solid fa-hashtag"></i>
                  <input
                    type="text"
                    class="form-control"
                    id="txtIddispositivo"
                    placeholder="Id Dispositivo"
                    autocomplete="off"
                    required
                    readonly
                    style="cursor: pointer; background-color: #fff;"
                    tabindex="4"
                  />
                </div>
              </div>
              <div class="col-md-6">
                <label for="dispositivo" class="form-label">Dispositivo</label>
                <div class="input-icon">
                  <i class="fa-solid fa-desktop"></i>
                  <input
                    type="text"
                    class="form-control"
                    id="txtdispositivo"
                    placeholder="Nombre del Dispositivo"
                    disabled="false"
                    tabindex="-1"
                 
                  />
                </div>
              </div>
              <div class="col-md-4">
                <label for="unidad" class="form-label">Id Catálogo</label>
                <div class="input-icon">
                  <i class="fa-solid fa-hashtag"></i>
                  <input
                    type="text"
                    class="form-control"
                    id="txtIdCatalogo"
                    autocomplete="off"
                    readonly
                    style="cursor: pointer; background-color: #fff;"
                    tabindex="5"
                    required
                  />
                </div>
              </div>
              <div class="col-md-8">
                <label for="unidad" class="form-label">Catálogo</label>
                <div class="input-icon">
                  <i class="fa-solid fa-list-ol"></i>
                  <input
                    type="text"
                    class="form-control"
                    id="txtnombrecatalogo"
                    placeholder="Nombre del Catálogo"
                    disabled="false"
                   tabindex="-1"
                  />
                </div>
              </div>
              <div class="col-md-12">
                <label for="unidad" class="form-label">Descripción</label>
                <div class="input-icon">
                  <textarea
                    type="text"
                    class="form-control"
                    id="txtdescripcioncatalogo"
                    placeholder="Descripción del Catálogo"
                    disabled="false"
                    tabindex="-1"
                  ></textarea>
                </div>
              </div>
            </div>
          </div>

          <!-- Sección Informacion del componente -->
          <div class="mb-5">
            <h3 class="section-title">
              <i class="fa-solid fa-circle-question"></i> Información del
              Componente
            </h3>
            <div class="row g-3">
              <div class="col-md-6">
                <label for="numeroserie" class="form-label"
                  >Número de serie</label
                >
                <div class="input-icon">
                  <i class="fas fa-building"></i>
                  <input
                    type="text"
                    class="form-control"
                    id="txtnumeroserie"
                    placeholder="Número de Serie"
                    autocomplete="off"
                    required
                    tabindex="6"
                  />
                </div>
              </div>
              <!-- CHECKBOX PARA GENERAR NÚMERO DE SERIE AUTOMÁTICO -->
    <div class="col-md-6 d-flex align-items-end">
      <div class="form-check form-switch">
        <input 
          class="form-check-input" 
          type="checkbox" 
          id="chkbxAutoSerie" 
          style="cursor: pointer;"
          tabindex="7"
        >
        <label 
          class="form-check-label fw-bold text-primary" 
          for="chkbxAutoSerie"
          style="cursor: pointer;"
        >
          <i class="fa-solid fa-wand-magic-sparkles"></i> Generar número de serie
        </label>
      </div>
    </div>
              <div class="col-md-6">
                <label for="statusequipo" class="form-label"
                  >Estado del Equipo</label
                >
                <div class="input-icon">
                  <i class="fa-solid fa-circle-check"></i>
                  <select class="form-select" id="statusequiposelect" tabindex="8" required>
                    <option value="" selected disabled>
                      Codición del Equipo
                    </option>
                    <option value="BUENAS CONDICIONES">
                      BUENAS CONDICIONES
                    </option>
                    <option value="MEDIA VIDA">MEDIA VIDA</option>
                    <option value="MAL ESTADO">MAL ESTADO</option>
                    <option value="EN REPARACION">EN REPARACION</option>
                    <option value="EXTRAVIADO">EXTRAVIADO</option>
                    <option value="EN REVISION">EN REVISION</option>
                    <option value="PARA PIEZAS">PARA PIEZAS</option>
                    <option value="DESCONTINUADO">DESCONTINUADO</option>
                    <option value="DESECHADO">DESECHADO</option>
                    <option value="SIN INFORMACION">SIN INFORMACION</option>
                  </select>
                </div>
              </div>
              <div class="col-md-6">
                <label for="lbfechadecompra" class="form-label"
                  >Fecha de compra</label
                >
                <div class="input-icon">
                  <i class="fas fa-calendar-alt"></i>
                  <input type="date" class="form-control" id="datefechacompra" tabindex="9" required/>
                </div>
              </div>
              <div class="group-servidorCliente col-md-6" id="servidorcliente">
                <label class="form-label">¿Es Servidor ó Cliente?</label>
                <div class="form-check">
                  <input
                    class="form-check-input"
                    name="servidorcliente"
                    type="radio"
                    id="chbxservidor"
                    value="SERVIDOR"
                    tabindex="10"
                
                  />
                  <label class="form-label" for="lbservidor">
                    SERVIDOR
                  </label>
                </div>
                <div class="form-check">
                  <input
                    class="form-check-input"
                    name="servidorcliente"
                    type="radio"
                    id="chbxcliente"
                    value="CLIENTE"
                    tabindex="11"
                  />
                  <label class="form-label" for="lbcliente">
                    CLIENTE
                  </label>
                </div>
                <div class="form-check">
                  <input
                    class="form-check-input"
                    name="servidorcliente"
                    type="radio"
                    id="chbxna"
                    value="N/A"
                    tabindex="12"
                    checked
                  />
                  <label class="form-label" for="lbna" >
                    N/A
                  </label>
                </div>
              </div>
              <div class="col-md-6">
                <label class="form-label">¿Activo en Inventario?</label>
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" id="switchinventario" tabindex="13" checked="true">
                  <label class="form-label" for="switchinventario">
                   ACTIVO
                  </label>
                </div>
              </div>
               <div class="col-md-12">
                <label for="observaciones" class="form-label">Observaciones</label>
                <div class="input-icon">
                  <textarea
                    type="text"
                    class="form-control"
                    id="txtobservaciones"
                    tabindex="14"
                    required
                  ></textarea>
                </div>
              </div>
             
            </div>
          </div>


          <!-- Sección de Factura -->
          <div class="mb-5">
            <h3 class="section-title">
              <i class="fas fa-info-circle"></i> Factura
            </h3>
            <div class="row g-3">
              <div class="col-md-6">
                <label for="unidad" class="form-label">Id Factura</label>
                <div class="input-icon">
                  <i class="fa-solid fa-hashtag"></i>
                  <input
                    type="text"
                    class="form-control"
                    id="txidfactura"
                    placeholder="Id Factura"
                     disabled="false"
                    required
                  />
                </div>
              </div>
              <div class="col-md-6">
                <label for="numerofactura" class="form-label">Número de Factura</label>
                <div class="input-icon">
                  <i class="fa-solid fa-file-lines"></i>
                  <input
                    type="text"
                    class="form-control"
                    id="txtnumerofactura"
                    placeholder="Número de Factura"
                     disabled="false"
                    required
                  />
                </div>
              </div>
              <div class="col-md-6">
                <label for="nombreproveedor" class="form-label">Nombre del Proveedor</label>
                <div class="input-icon">
                  <i class="fa-solid fa-users"></i>
                  <input
                    type="text"
                    class="form-control"
                    id="txtnombreprovedor"
                    placeholder="Nombre de Proveedor"
                     disabled="false"
                    required
                  />
                </div>
              </div>
              <div class="col-md-6">
                <label for="lugarcompra" class="form-label">Lugar de Compra</label>
                <div class="input-icon">
                  <i class="fa-solid fa-store"></i>
                  <input
                    type="text"
                    class="form-control"
                    id="txtlugarcompra"
                    placeholder="Lugar de Compra"
                    disabled="false"
                    required
                  />
                </div>
              </div>
              <div class="col-md-4">
                <label for="fechafactura" class="form-label">Fecha de Factura</label>
                <div class="input-icon">
                  <i class="fa-solid fa-calendar-days"></i>
                  <input
                    type="date"
                    class="form-control"
                    id="datefechafactura"
                    disabled="false"
                    required
                  />
                </div>
              </div>
              <div class="col-md-2">
                <div class="input-icon">
                  <button type="button" class="btn btn-success" id="btnguardarfactura" style="margin-top: 30px;">
                    Guardar Factura
                </div>
              </div>
              <div class="col-md-2">
                <div class="input-icon">
                  <button type="button" class="btn btn-warning" id="btneditarfactura" style="margin-top: 30px;">
                     Editar Factura
                </div>
              </div>
               <div class="col-md-2">
                <div class="input-icon">
                  <button type="button" class="btn btn-primary" id="btnnuevafactura" style="margin-top: 30px;" >
                    Nueva Factura
                </div>
              </div>
              <div class="col-md-2">
                <div class="input-icon">
                  <button type="button" class="btn btn-danger" id="btncancnuevafactura" style="margin-top: 30px;" hidden="true">
                    Cancelar Factura
                </div>
              </div>

              <div class="col-md-12">
                <label for="observaciondefactura" class="form-label">Observaciones de Factura</label>
                <div class="input-icon">
                  <textarea
                    type="date"
                    class="form-control"
                    id="txtobservacionfactura"
                    disabled="false"
                    placeholder="Observaciones de Factura"
                    required
                  ></textarea>
                </div>
              </div>
     <div class="col-md-6 d-flex align-items-end">
        <div class="form-check form-switch">
        <input 
          class="form-check-input" 
          type="checkbox" 
          id="chkbxImpresionRapida" 
          style="cursor: pointer;"
          >
        <label 
          class="form-check-label fw-bold text-primary" 
          for="chkbxImpresionRapida"
          style="cursor: pointer;"
        >
          <i class="fa fa-print"></i> Impresión Rápida
        </label>
        </div>
    </div>
            </div>
          </div>

          <!-- Botones de envío -->
          <div class="d-flex justify-content-between mt-4">
            <button type="button" class="btn btn-outline-secondary">
              <i class="fas fa-arrow-left me-2"></i>Volver
            </button>

            <button type="submit" id="btnmodificar" class="btn btn-primary btn-submit" tabindex="15">
              <i class="fa-solid fa-floppy-disk"></i> Agregar Componente
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="/js/RouterAPI/Componentes/RouterAgregarComponente.js" type="module"></script>


<%- include("../template/footer") %>
<%- include("../Unidades/modal/ModalConsultarUnidades") %>
<%- include("../Dispositivos/modal/ModalConsultarDispositivos") %>
<%- include("../Areas/modal/ModalConsultarAreas") %>
<%- include("../Catalogos/modal/ModalConsultarCatalogosComponentes") %>
<%- include("../Factura/modal/ModalConsultar_Factura") %>
<%- include("../Responsables/modal/ModalConsultar_Responsable") %>
<%- include("../ImpresionQR/modal/ModalGeneradorQR") %>
