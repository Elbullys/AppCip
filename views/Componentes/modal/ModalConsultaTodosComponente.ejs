<!-- Modal para mostrar los detalles del componente -->
<div
  class="modal fade"
  id="consultaComponentesModal"
  data-bs-backdrop="static"
  data-bs-keyboard="true"
  tabindex="-1"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title titulo_modal">Selecciona el Componente</h5>
        <button
          type="button"
          class="btn-close-custom btn-secondary"
          data-bs-dismiss="modal"
          tabindex="-1"
        >
          <i class="fas fa-times"></i>
        </button>
      </div>
      <div class="modal-body">
        <div class="card-body">
          <div class="input-group mb-3">
            <input
              type="text"
              id="inputBusquedaComponente"
              class="form-control"
              placeholder="Buscar Componente..."
              autocomplete="off"
              autofocus
              tabindex="1"
            />
            <button
              id="btnBuscarcomponente"
              class="btn btn-primary"
              tabindex="2"
            >
              Buscar
            </button>
          </div>
        </div>
        <div class="card-body">
          <div class="table-responsive mb-3">
            <table
              id="table_Modal_componentes"
              class="table tableModalConsulta table-striped table-hover table-sm"
              style="width: 100%"
              tabindex="3"
            >
              <thead>
                <tr>
                  <th scope="col">#</th>
                  <th scope="col">Responsable</th>
                  <th scope="col">Unidad</th>
                  <th scope="col">Dispositivo</th>
                  <th scope="col">Catálogo</th>
                  <th scope="col">Número de Serie</th>
                  <th scope="col">Operación</th>
                  <th scope="col">Código TI</th>
                  <th scope="col">Observación</th>
                  <th scope="col">Status</th>
                  <th scope="col">Área</th>
                  <th scope="col">Activo/Baja</th>
                </tr>
              </thead>
              <tbody class="table-body-scroll" tabindex="4" ></tbody>
            </table>
          </div>
          
          
          
          <div class="text-center mt-2">
            <button
              type="button"
              id="btnSeleccionarComponente"
              class="btn btn-primary"
            >
              Seleccionar
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>