<%- include("../template/cabecera",{tituloweb:'Carga De Inventario Componentes'}) %>
<%- include("../template/navbar") %>
<script src="https://cdn.jsdelivr.net/npm/xlsx-js-style@1.2.0/dist/xlsx.bundle.js"></script>

<div class="container py-4">
    <main class="container-fluid mt-5">
        <h3 class="text-center mb-4">Actualización de Inventario Componente Por Colectivo</h3>
    </main>


    <div class="card mb-4">
        <div class="card-body">
            <form id="uploadForm" enctype="multipart/form-data">
                <fieldset>
                    <legend class="visually-hidden">Información del Inventario</legend>


                    <div class="row g-3 mb-3">
                        <div class="col-md-2 col-lg-2">
                            <label for="inputunidad" class="form-label">Unidad</label>
                            <input type="text" class="form-control" id="inputunidad" placeholder="Ej. Unidad Central" autocomplete="off" required />
                        </div>
                        <div class="col-md-2">
                            <label for="inputresponsable" class="form-label">Responsable</label>
                            <input type="text" class="form-control" id="inputresponsable" placeholder="Responsable" autocomplete="off" required />
                        </div>
                        <div class="col-md-2">
                            <label for="inputarea" class="form-label">Ubicación</label>
                            <input type="text" class="form-control" id="inputarea" placeholder="Área" autocomplete="off" required />
                        </div>
                        <div class="col-md-3">
                            <label for="inputdispositivos" class="form-label">Dispositivos</label>
                            <input type="text" class="form-control" id="inputdispositivos" placeholder="Dispositivos" autocomplete="off" required />
                        </div>
                        <div class="col-md-3">
                            <label for="inputcatalogo" class="form-label">Catálogo</label>
                            <input type="text" class="form-control" id="inputcatalogo" placeholder="Catálogo" autocomplete="off" required />
                        </div>
                    </div>


                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label for="inputIdfactura" class="form-label">Id Factura</label>
                            <input type="text" class="form-control" id="inputIdfactura" placeholder="Id Factura" autocomplete="off" required />
                        </div>
                        <div class="col-md-3">
                            <label for="factura" class="form-label">Factura</label>
                            <input type="text" class="form-control" id="inputfactura" placeholder="Factura" autocomplete="off" required disabled/>
                        </div>
                        <div class="col-md-3">
                            <label for="inputnombreproveedor" class="form-label">Nombre Proveedor</label>
                            <input type="text" class="form-control" id="inputnombreproveedor" placeholder="Proveedor" autocomplete="off" required disabled/>
                        </div>
                        
                    </div>
                    <div class="row g-3 mb-3">
                    <div class="col-md-12">
                            <label for="inputdescripcioncatalogo" class="form-label">Descripción del Catálogo</label>
                            <textarea class="form-control" id="inputdescripcioncatalogo" placeholder="Descripción del catálogo" rows="2" autocomplete="off" disabled></textarea>
                        </div>
                    </div>
                    


                    <div class="d-flex justify-content-end mb-3">
                        <button type="button" class="btn btn-secondary btn-sm" id="downloadTemplate">
                            <i class="fas fa-download me-2"></i>Descargar Plantilla Colectivo
                        </button>
                    </div>
                </fieldset>

         
                <div class="mb-3">
                    <label for="excelFile" class="form-label">Archivo Excel</label>
                    <div class="input-group">
                        <input type="file" class="form-control" id="excelFile" name="excelFile" accept=".xlsx, .xls" required />
                        <button class="btn btn-primary btn-sm" type="button" id="btnsubirform">Cargar y Mostrar Excel</button>
                    </div>
                    <div class="form-text">Solo archivos .xlsx o .xls. Se mostrará una vista previa de los datos.</div>
                </div>
            </form>
        </div>
    </div>


    <div class="card mb-4" id="processedTableContainer" style="display: none;">
        <div class="card-body">
            <h3>Datos Procesados del Excel</h3>
            <div class="badge bg-danger mb-3">Errores: <span id="errorCount">0</span></div>
            <table id="processedTable" class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Número de Serie</th>
                        <th>Estado</th>
                        <th>Detalles</th>
                        <th>Status Componente</th>
                        <th>Observación</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>


    <div class="d-grid mb-3">
        <button type="button" class="btn btn-primary btn-sm d-none" id="btnVerificacionyActualizacion">
            <i class="fa-solid fa-pen-to-square me-2"></i>Actualizar Componentes
        </button>
    </div>
</div>

<!-- Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="/js/RouterAPI/Inventarios/RouterEditarComponentePorColectivo.js" type="module"></script>

<%- include("../template/footer") %>
<%- include("../Unidades/modal/ModalConsultarUnidades") %>
<%- include("../Areas/modal/ModalConsultarAreas") %>
<%- include("../Dispositivos/modal/ModalConsultarDispositivos") %>
<%- include("../Catalogos/modal/ModalConsultarCatalogosComponentes") %>
<%- include("../Factura/modal/ModalConsultar_Factura") %>
<%- include("../Responsables/modal/ModalConsultar_Responsable") %>