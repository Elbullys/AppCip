<%- include("../template/cabecera",{tituloweb:'Carga De Inventario Componentes'}) %>
<%- include("../template/navbar") %>
<script src="https://cdn.jsdelivr.net/npm/xlsx-js-style@1.2.0/dist/xlsx.bundle.js"></script>
<div class="container py-4">  
    <main class="container-fluid mt-5">
         <h3 class="text-center mb-4">Actualización de Inventario Componente Por Colectivo</h3>  <!-- Centrado -->
    </main>
       
    <div class="card mb-4">  <!-- Card para formulario -->
        <div class="card-body">
            <form id="uploadForm" enctype="multipart/form-data">
                <fieldset>
                    <legend class="visually-hidden">Información del Inventario</legend>
                    <div class="row g-3 mb-3">
                        <div class="col-md-2 col-lg-2">  <!-- Mejor responsividad -->
                            <label for="unidad" class="form-label">Unidad</label>
                            <input type="text" class="form-control" id="inputunidad" placeholder="Ej. Unidad Central" autocomplete="off" required />
                        </div>
                        <div class="col-md-2">
                    <label for="responsable" class="form-label">Responsable</label>
                    <input
                    type="text"
                    class="form-control"
                    id="inputresponsable"
                    placeholder="Responsable"
                    autocomplete="off"
                    required
                  />
                </div>
                <div class="col-md-2">
                    <label for="area" class="form-label">Ubicación</label>
                    <input
                    type="text"
                    class="form-control"
                    id="inputarea"
                    placeholder="Área"
                    autocomplete="off"
                    required
                  />
                </div>
                 <div class="col-md-3">
                    <label for="dispositivos" class="form-label">Dispositivos</label>
                    <input
                    type="text"
                    class="form-control"
                    id="inputdispositivos"
                    placeholder="Dispositivos"
                    autocomplete="off"
                    required
                  />
                </div>
                <div class="col-md-3">
                    <label for="catalogo" class="form-label">Catálogo</label>
                    <input
                    type="text"
                    class="form-control"
                    id="inputcatalogo"
                    placeholder="Catálogo"
                    autocomplete="off"
                    required
                  />
                </div>
                        <div class="col-md-12">
                            <label for="inputdescripcioncatalogo" class="form-label">Descripción del Catálogo</label>
                            <textarea class="form-control" id="inputdescripcioncatalogo" placeholder="Descripción del catálogo" rows="2" autocomplete="off" disabled="true"></textarea>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end mb-3">  <!-- Botón alineado a la derecha -->
                        <button type="button" class="btn btn-secondary btn-sm" id="downloadTemplate"><i class="fas fa-download me-2"></i>Descargar Plantilla Colectivo</button>
                    </div>
                </fieldset>

                <div class="mb-3">
                    <label for="excelFile" class="form-label">Archivo Excel</label>
                    <div class="input-group">  <!-- Grupo para input y botón -->
                        <input type="file" class="form-control" id="excelFile" name="excelFile" accept=".xlsx, .xls" required>
                        <button class="btn btn-primary btn-sm" type="button" id="btnsubirform">Cargar y Mostrar Excel</button>
                    </div>
                    <div class="form-text">Solo archivos .xlsx o .xls. Se mostrará una vista previa de los datos.</div>
                </div>
            </form>
        </div>
    </div>

    <div class="card mb-4" id="processedTableContainer" style="display: none;">  <!-- Card para tabla -->
        <div class="card-body">
            <h3>Datos Procesados del Excel</h3>
            <div class="badge bg-danger mb-3">Errores: <span id="errorCount">0</span></div>  <!-- Indicador de errores -->
            <table id="processedTable" class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>#</th>  <!-- Agregado para enumeración -->
                        <th>Número de Serie</th>
                        <th>Estado</th>
                        <th>Detalles</th>
                         <th>Status Componente</th> 
                         <th>Observación</th>
                        
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <div  class="d-grid mb-3">  
        <button type="button" class="btn btn-primary btn-sm d-none" id="btnVerificacionyActualizacion" ><i class="fa-solid fa-pen-to-square me-2" ></i>Actualizar Componentes</button>
    </div>
</div>

<!-- Scripts igual -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="/js/RouterAPI/Inventarios/RouterEditarComponentePorColectivo.js" type="module"></script>
