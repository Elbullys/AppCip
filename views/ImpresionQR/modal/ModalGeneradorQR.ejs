
<div
  class="modal fade"
  id="modalDetalleQR"
  tabindex="-1"
  data-bs-backdrop="static"
  aria-labelledby="modalDetalleQRLabel"
  tabindex="-1"
  aria-hidden="true"
>
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalDetalleQRLabel">
          Generador de Etiqueta QR
        </h5>
        <button
          type="button"
          class="btn-close btn-close-white"
          data-bs-dismiss="modal"
          aria-label="Close"
          id="btoncerrarmodal"
        ></button>
      </div>

      <div class="modal-body p-4">
        <div class="row align-items-center">
          <div class="col-md-7 pe-md-4">
            <div class="mb-4">
              <label class="small fw-bold">ID del Componente</label>
              <div id="view_id" class="fs-4 fw-bold ">----</div>
            </div>

            <div class="row g-3">
              <div class="col-6">
                <label class="small fw-bold">Código TI</label>
                <div id="view_codigo_ti" class="p-2 border rounded text-center">
                  --
                </div>
              </div>
              <div class="col-6">
                <label class="small fw-bold">N° de Serie</label>
                <div
                  id="view_numero_serie"
                  class="p-2 border rounded bg-light text-truncate"
                >
                  --
                </div>
              </div>

              <div class="col-12">
                <label class="small fw-bold">Dispositivo</label>
                <div id="view_dispositivo" class="fw-semibold">--</div>
              </div>

              <div class="col-6">
                <label class="small fw-bold">Marca</label>
                <div id="view_marca">--</div>
              </div>
              <div class="col-6">
                <label class="small fw-bold">Modelo</label>
                <div id="view_modelo">--</div>
              </div>
            </div>

            <div class="mt-4 pt-3 border-top">
              <div class="row align-items-center g-3">
                <div class="col-auto">
                  <div class="p-2 d-flex align-items-center">
                    <input
                      class="form-check-input me-2"
                      type="checkbox"
                      id="checkRegulatorio"
                      style="cursor: pointer; width: 1.5rem; height: 1.5rem"
                    />
                    <label
                      class="fw-bold mb-0"
                      for="checkRegulatorio"
                      style="cursor: pointer"
                    >
                      <i class="fas fa-shield-alt text-secondary me-1 ml-5"></i>
                     Código Regulatorio
                    </label>
                  </div>
                </div>

                <div
                  id="container-input-regulatorio"
                  class="col d-none animate__animated animate__fadeInSide"
                >
                  <div class="input-group">
                    <span
                      class="input-group small fw-bold"
                      >Código:</span
                    >
                    <input
                      type="text"
                      id="inputRegulatorio"
                      class="form-control"
                      placeholder="Norma aplicable..."
                    />
                  </div>
                </div>
              </div>
            </div>
          </div>

        <div class="col-md-5 text-center border-start d-flex flex-column align-items-center justify-content-center py-3">
    <div class="etiqueta-preview-container p-2">
        
        <div id="etiqueta-real" class="etiqueta-sticker">
            <div class="qr-box">
                <img id="img_qr" src="/resources/exampleQR.png" alt="QR">
            </div>
            
            <div class="text-box">
                <div class="label-ti">Código TI:</div>
                <div id="view_codigo_ti_etiqueta" class="value-ti">--</div>
            </div>
            <div class="text-box" id="textboxregulatorio" hidden>
                <div class="label-ti">Código Regulatorio:</div>
                <div id="view_codigo_regulatorio_etiqueta" class="Regulatorio">--</div>
            </div>
        </div>

    </div>
    <p class="small text-muted mt-3 mb-0">
        <i class="fas fa-eye me-1"></i> Vista previa de impresión
    </p>
</div>
        </div>
      </div>

      <div class="modal-footer bg-light">
        <button
          type="button"
          class="btn btn-outline-secondary"
          id="btncerrar"
        >
          Cerrar
        </button>
        <button type="button" id="btnGenerarQR" class="btn btn-primary">
          <i class="fas fa-qrcode me-2"></i>Generar QR
        </button>
        <button
          type="button"
          id="btnImprimirEtiqueta"
          class="btn btn-dark"
          disabled
        >
          <i class="fas fa-print me-2"></i>Imprimir Etiqueta
        </button>
      </div>
    </div>
  </div>
</div>
