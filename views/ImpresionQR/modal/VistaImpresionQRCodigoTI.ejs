<!-- ============================================ -->
<!-- ETIQUETA 1: CON CÓDIGO REGULATORIO -->
<!-- ============================================ -->
<div id="area-impresion-regulatorio" class="d-none">
    <div class="etiqueta-regulatorio">
        <!-- QR Code -->
        <div class="qr-regulatorio">
            <div id="qr-regulatorio"></div>
        </div>
        
        <!-- Textos -->
        <div class="textos-regulatorio">
            <div class="linea-1">
                <span class="label-bold">Código TI:</span>
            </div>
            <div class="linea-2">
                <span id="print-codigo-ti-reg" class="codigo-normal">---</span>
            </div>
            <div class="linea-3">
                <span class="label-bold">Código</span>
            </div>
            <div class="linea-4">
                <span class="label-bold">Regulatorio:</span>
            </div>
            <div class="linea-5">
                <span id="print-codigo-reg" class="codigo-chico">---</span>
            </div>
        </div>
    </div>
</div>

<!-- ============================================ -->
<!-- ETIQUETA 2: SOLO CÓDIGO TI (SIN REGULATORIO) -->
<!-- ============================================ -->
<div id="area-impresion-ti" class="d-none">
    <div class="etiqueta-ti">
        <!-- QR Code -->
        <div class="qr-ti">
            <div id="qr-ti"></div>
        </div>
        
        <!-- Textos -->
        <div class="textos-ti">
            <div class="linea-1-ti">
                <span class="label-bold">Código TI:</span>
            </div>
            <div class="linea-2-ti">
                <span id="print-codigo-ti-simple" class="codigo-grande">---</span>
            </div>
        </div>
    </div>
</div>